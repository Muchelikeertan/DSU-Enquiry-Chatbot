# ==============================================================================
# DSU College Enquiry Chatbot - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=127.0.0.1

# Canonical JSON Data Paths (Relative to project root or absolute paths)
INTENTS_JSON_PATH=intents.json
COLLEGE_INFO_JSON_PATH=college_info.json
FAQ_INFO_JSON_PATH=faq_info.json

# NLP Pipeline Configuration
INTENT_CONFIDENCE_THRESHOLD=0.60
FAQ_CONFIDENCE_THRESHOLD=0.65
CONTEXT_TTL_TURNS=6

# LLM Fallback Service (Groq API)
# Get a free Groq API key from https://console.groq.com/
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=15.0
GROQ_MAX_RETRIES=1

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:your_postgres_password@localhost:5432/dsu_chatbot

# Admission Cell Admin & Security Settings
# Change SECRET_KEY in production to a cryptographically secure random string!
SECRET_KEY=replace_with_a_secure_random_secret
ADMIN_USERNAME=replace_with_your_admin_username
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_EMAIL=admissions@dsu.edu.in
ACCESS_TOKEN_EXPIRE_MINUTES=480
