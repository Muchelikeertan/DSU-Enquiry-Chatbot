{
    "schema_version": "3.1",
    "last_updated": "2026-10-18",
    "meta": {
        "integrity_rules": [
            "Intent tags are unique. This file is the only registry of intent tags.",
            "Every faq_info.faqs[*].intent must be a tag defined in this file.",
            "Every faq_info.faqs[*].course_id / course_ids value must exist as an id in college_info.sca.courses[*] or in college_info.schools[*] programmes (including colleges[*].programmes[*]).",
            "A static or form FAQ may only attach to an intent whose handler has faq_static true in handler_compatibility.",
            "A dynamic FAQ's dynamic_handler must appear in handler_compatibility[intent handler].faq_dynamic_handlers.",
            "show_enquiry_form is true only when form_policy is always; otherwise it is false.",
            "A static FAQ whose answer text tells the student to use the enquiry form (or whose answer_mode is form) must have form_policy always. A static FAQ whose answer does not mention the form must have form_policy never. A dynamic FAQ must have form_policy on_failure.",
            "Every tag used in context_rules must be defined in this file, including internal intents.",
            "Every status value used in any file must be a key in college_info.meta.status_values.",
            "If the classifier returns a tag not defined here, look it up in legacy_tag_aliases before falling back."
        ],
        "entity_sources": {
            "course": "college_info.sca.courses[*] and college_info.schools[*] programmes (match on id and aliases)",
            "school": "college_info.schools[*] (match on id and aliases)"
        },
        "status_values_ref": "college_info.meta.status_values"
    },
    "legacy_tag_aliases": {
        "sca_overview": "sca_info",
        "sca_programmes": "sca_courses",
        "sca_programs": "sca_courses",
        "university_contact": "university_contact_address",
        "sca_fee": "sca_fees",
        "sca_head": "sca_dean"
    },
    "handler_definitions": {
        "canned_response": "Reply with a message from the intent's 'responses' list.",
        "local": "Answer only from faq_info.json / college_info.json. No LLM for ordinary supported questions. If there is no confident FAQ match, use the intent's fallback_handler.",
        "local_then_llm": "Try local data first. If there is no confident match or the needed field is null, call the LLM with official DSU sources.",
        "llm": "Call the LLM with official DSU sources. The LLM must say when something cannot be verified.",
        "llm_fee_lookup": "LLM looks up the 2026-27 fee for the exact course or specialisation. If unverified, show college_info.enquiry.fee_fallback_message and the enquiry form.",
        "context_follow_up": "Resolve using context_rules, then re-route to the target intent. If requires_context is true and no slot is set, route to ask_which_course.",
        "enquiry_form": "Display the enquiry form."
    },
    "handler_compatibility": {
        "canned_response": {
            "faq_static": false,
            "faq_dynamic_handlers": []
        },
        "local": {
            "faq_static": true,
            "faq_dynamic_handlers": []
        },
        "local_then_llm": {
            "faq_static": true,
            "faq_dynamic_handlers": [
                "llm"
            ]
        },
        "llm": {
            "faq_static": false,
            "faq_dynamic_handlers": [
                "llm"
            ]
        },
        "llm_fee_lookup": {
            "faq_static": false,
            "faq_dynamic_handlers": [
                "llm_fee_lookup"
            ]
        },
        "context_follow_up": {
            "faq_static": false,
            "faq_dynamic_handlers": []
        },
        "enquiry_form": {
            "faq_static": true,
            "faq_dynamic_handlers": []
        },
        "fallback_handler_allowed_values": [
            "llm",
            "llm_fee_lookup"
        ]
    },
    "enquiry_form_rules": {
        "show_enquiry_form": "Boolean. true = show the form together with this answer.",
        "form_policy": "String enum: never | always | on_failure.",
        "allowed_combinations": [
            {
                "show_enquiry_form": false,
                "form_policy": "never",
                "meaning": "Fully answered; do not show the form."
            },
            {
                "show_enquiry_form": false,
                "form_policy": "on_failure",
                "meaning": "Show the form only if the lookup or LLM cannot verify the answer."
            },
            {
                "show_enquiry_form": true,
                "form_policy": "always",
                "meaning": "Show the form with this answer."
            }
        ],
        "static_faq_guidance": "Use always when the fact the student asked for is unverified or unpublished, or when the answer itself tells the student to use the form. Use never when the question is answered and the answer only points to an official page or helpline.",
        "dynamic_faq_guidance": "Use on_failure so the form appears only if the lookup cannot verify the answer."
    },
    "context_rules": {
        "ttl_turns": 6,
        "slots": [
            "course_id",
            "specialisation_text",
            "school_id",
            "topic_intent",
            "last_faq_id",
            "last_answer_status"
        ],
        "update_rules": [
            "If the message names a course (id or alias), set course_id and set school_id to that course's school. Clear specialisation_text unless the message gives one.",
            "If the message names only a school, set school_id and clear course_id.",
            "After answering a non-follow-up intent, set topic_intent to that tag. Do not update topic_intent for greeting, goodbye, thanks, chatbot_capabilities, enquiry, fallback, ask_which_course or ask_what_to_know.",
            "Store last_faq_id and last_answer_status (a value from college_info.meta.status_values) after every answer.",
            "Clear all slots after ttl_turns turns without an update.",
            "An entity named in the current message always overrides the stored context."
        ],
        "cue_words": [
            "it",
            "its",
            "that",
            "this",
            "that course",
            "this course",
            "the same",
            "there",
            "that one",
            "this one"
        ],
        "scope_by_course_id_prefix": {
            "sca_": "sca",
            "soe_": "other",
            "scm_": "other",
            "sbas_": "other",
            "shs_": "other",
            "sadh_": "other",
            "sddt_": "other",
            "sol_": "other"
        },
        "follow_up_resolution": {
            "follow_up_fee": {
                "sca": "sca_fees",
                "other": "other_department_fees",
                "school_only": "ask_which_course"
            },
            "follow_up_eligibility": {
                "sca": "sca_eligibility",
                "other": "admissions_eligibility",
                "school_only": "ask_which_course"
            },
            "follow_up_duration": {
                "sca": "sca_course_duration",
                "other": "other_department_courses",
                "school_only": "other_department_courses"
            },
            "follow_up_location": {
                "sca": "sca_location",
                "other": "course_location",
                "school_only": "course_location"
            },
            "follow_up_more_details": {
                "sca": {
                    "bundle": [
                        "sca_course_duration",
                        "sca_eligibility",
                        "sca_fees",
                        "sca_location"
                    ]
                },
                "other": {
                    "bundle": [
                        "other_department_courses",
                        "course_location",
                        "other_department_fees"
                    ]
                },
                "school_only": {
                    "sca_school": "sca_info",
                    "other_school": "other_department_courses"
                },
                "topic_only": {
                    "action": "repeat_topic_intent",
                    "detail": "more"
                }
            },
            "follow_up_other_course": {
                "with_topic": {
                    "action": "rerun_topic_intent_with_new_course"
                },
                "without_topic": "ask_what_to_know"
            }
        },
        "after_failed_lookup": "If last_answer_status is not_verified (or the lookup failed) and the student asks for more, show the enquiry form instead of retrying.",
        "no_context_clarification": {
            "intent": "ask_which_course",
            "quick_replies_ref": "college_info.sca.courses[*].name"
        },
        "ask_what_to_know": {
            "intent": "ask_what_to_know"
        }
    },
